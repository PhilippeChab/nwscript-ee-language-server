{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "emscripten"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16"
  },
  "include": ["scripts", "test"]
}
