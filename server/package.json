{
  "name": "nwscript-lsp-server",
  "description": "NWScript LSP Server. ",
  "license": "GPL-3.0-only",
  "version": "1.0.0",
  "author": {
    "name": "Philippe Chabot"
  },
  "publisher": "PhilippeChab",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhilippeChab/nwscript-ee-language-server"
  },
  "engines": {
    "node": "*"
  },
  "scripts": {
    "build": "ts-node scripts/Build.ts",
    "check-standard-lib": "ts-node scripts/GenerateLibDefinitions.ts --check",
    "generate-lib-defs": "ts-node scripts/GenerateLibDefinitions.ts",
    "test": "node --no-experimental-strip-types ./node_modules/mocha/bin/mocha.js -r ts-node/register \"test/**/*.ts\"",
    "update-standard-lib": "ts-node scripts/UpdateStandardLibrary.ts",
    "package:standalone": "ts-node scripts/PackageStandalone.ts",
    "test:standalone": "node --no-experimental-strip-types ./node_modules/mocha/bin/mocha.js -r ts-node/register test/standalone_test.ts"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "sax": "^1.6.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/sax": "^1.2.7",
    "adm-zip": "^0.6.1",
    "chai": "^4.5.0",
    "mocha": "^12.0.2",
    "ts-node": "^10.9.2",
    "@types/emscripten": "1.41.6"
  },
  "type": "commonjs"
}
