{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
